# ============================================
# 知识库 (ZhiShiKu) 环境变量配置
# 将此文件复制为 .env 并填入实际值
# ============================================

# ── GitHub 同步配置 ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/your-knowledge-repo
GITHUB_BRANCH=main
GITHUB_DOCS_PATH=docs

# ── Qdrant 向量数据库配置 ──
# Qdrant Cloud: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=zhishiku

# ── Embedding 嵌入配置 ──
# 提供商: openai / gemini / local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 如果使用 OpenAI 嵌入，填 OpenAI API Key
# 如果使用 Gemini 嵌入，填 Google API Key
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 可选：自定义 API 地址（用于代理或兼容接口）
# EMBEDDING_API_BASE=https://api.openai.com/v1

# ── LLM 配置（自动修订引擎）──
# 提供商: openai / gemini / deepseek
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 可选：自定义 API 地址
# LLM_API_BASE=https://api.openai.com/v1

# DeepSeek 示例:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_API_BASE=https://api.deepseek.com/v1

# Gemini 示例:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-google-api-key

# ── 认证配置 ──
# 用于保护 API 的 Bearer Token（留空则不启用认证）
AUTH_TOKEN=your-secret-auth-token

# ── 服务配置 ──
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
